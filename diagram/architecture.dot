digraph AwsArchitecture {
  graph [rankdir=LR, bgcolor="white", pad="0.32", nodesep="0.42", ranksep="0.76", fontname="Arial", fontsize=18, label="Incident Handoff Tracker | AWS Architecture", labelloc=t, labeljust=l, splines=polyline];
  node [shape=box, style="rounded,filled", penwidth=1.4, fontname="Arial", fontsize=12, margin="0.18,0.15", color="#9DADBA", fontcolor="#1E2A33", fillcolor="#F1F6F9"];
  edge [color="#587081", penwidth=1.7, arrowsize=.75, fontname="Arial", fontsize=10, fontcolor="#536876"];

  client [label="Windows client / browser\nFictional demo data", fillcolor="#EAF1FA"];
  api [label="Amazon API Gateway\nHTTP API + IAM routes\nHTTPS + throttling", fillcolor="#DCEBF9"];
  lambda [label="AWS Lambda\nPython incident handler\nAuto scales", fillcolor="#FFEDD5"];
  db [label="Amazon DynamoDB\nIncident records\nOn-demand", fillcolor="#F1E7FF"];
  s3 [label="Amazon S3\nPrivate JSON snapshots\nSSE-S3 + lifecycle", fillcolor="#ECF9EB"];
  logs [label="CloudWatch Logs\n7-day retention", fillcolor="#F5F2E3"];
  alarm [label="CloudWatch Alarm\nLambda Errors >= 1", fillcolor="#F9ECEB"];
  iam [label="IAM execution role\nScoped access to DDB, S3, logs", fillcolor="#F2F3F5"];

  client -> api [label="GET /health (public)\nPOST /incidents (signed)"];
  api -> lambda [label="Lambda proxy event"];
  lambda -> db [label="PutItem / GetItem"];
  lambda -> s3 [label="PutObject archive"];
  lambda -> logs [label="Execution logs"];
  lambda -> alarm [label="Errors metric", style=dashed, color="#B68562"];
  iam -> lambda [label="Least privilege", style=dashed, color="#8297A3", constraint=false];
  {rank=same;db;s3;}
  {rank=same;logs;alarm;}
}
